{
  "name": "OKX只读量化风险报告（重建模板）",
  "active": false,
  "settings": {
    "timezone": "Asia/Shanghai",
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "schedule",
      "name": "每30分钟",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      }
    },
    {
      "id": "run",
      "name": "运行只读风险报告器",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        260,
        0
      ],
      "parameters": {
        "command": "cd /root/okx-demo-risk-reporter && python3 live_reporter.py"
      }
    },
    {
      "id": "telegram",
      "name": "发送Telegram报告",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.stdout }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "[REDACTED]",
          "name": "[REDACTED]"
        }
      }
    }
  ],
  "connections": {
    "每30分钟": {
      "main": [
        [
          {
            "node": "运行只读风险报告器",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "运行只读风险报告器": {
      "main": [
        [
          {
            "node": "发送Telegram报告",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
