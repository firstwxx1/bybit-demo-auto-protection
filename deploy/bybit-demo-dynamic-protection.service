[Unit]
Description=Bybit mainnet Demo Trading dynamic protection bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bybit-n8n
Group=bybit-n8n
WorkingDirectory=@APP_DIR@
EnvironmentFile=@APP_DIR@/.env
Environment=DYNAMIC_PROTECTION_PORT=38636
Environment=BYBIT_API_BASE=https://api-demo.bybit.com
Environment=BYBIT_TRADING_MODE=demo
Environment=PATH=@APP_DIR@/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@APP_DIR@/.venv/bin/python @APP_DIR@/dynamic_protection_service.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
