[Unit]
Description=OKX demo dynamic protection bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=okx-n8n
Group=okx-n8n
WorkingDirectory=/opt/okx-demo-risk-reporter
EnvironmentFile=/etc/okx-demo-risk-reporter.env
Environment=DYNAMIC_PROTECTION_PORT=38636
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /opt/okx-demo-risk-reporter/dynamic_protection_service.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target